# Variables del cliente RicoQuiz+ (plantilla, sin secretos)
#
# OJO: la app NO usa este archivo. Solo existe porque la entrega pide que la URL del
# servidor de tiempo real aparezca en un .env.example; los valores reales van en
# src/environments/.
#
# Angular no lee archivos .env: estas variables se copian a mano en
# src/environments/environment.ts (producción) y environment.development.ts (desarrollo).
# La equivalencia está a la derecha de cada una. Ver "Variables de entorno" en el README.
#
# Todos son valores públicos (viajan al navegador): los secretos viven solo en la API.

# URL base de la API REST                       -> environment.apiUrl
API_URL=https://TU-API.onrender.com

# Servidor de tiempo real (Socket.IO)           -> environment.socketUrl
SOCKET_URL=https://TU-API.onrender.com

# Namespace de Socket.IO para las partidas      -> environment.socketNamespace
SOCKET_NAMESPACE=/matches

# Client ID de Google Identity Services         -> environment.googleClientId
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
